# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# KASSIX Pro payments (server-only; never prefix these with NEXT_PUBLIC_)
# Supabase → Project Settings → API Keys → Secret keys. Used only by the PayMongo webhook.
SUPABASE_SECRET_KEY=sb_secret_...
# PayMongo → Developers → API Keys (sk_test_... while testing, sk_live_... when live)
PAYMONGO_SECRET_KEY=sk_test_...
# PayMongo → Developers → Webhooks → your endpoint's secret
PAYMONGO_WEBHOOK_SECRET=whsk_...
